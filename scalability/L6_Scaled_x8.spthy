theory L6_Scaled_x8
begin

/*
 * Generated by scalability/generate.py, K = 8.
 *
 * Layer 6 with a larger BPMN model: 8 webshop stage(s) in sequence,
 * 64 nodes, 63 admissible transitions, 8 parallel split(s) and
 * 8 event-based gateway(s). Every node has a fresh identifier per
 * instance, and a token is Token(~node). The dishonest participant may fire
 * any enabled transition of any instance in any order.
 */

// A new process instance: a fresh identifier for every node, and the
// structure of the process over these identifiers
rule Instance_Start:
    [ Fr(~Start), Fr(~OrderCreated1), Fr(~Split1), Fr(~NotifyWarehouse1), Fr(~EBG1), Fr(~message1), Fr(~timer1), Fr(~signal1), Fr(~Continue1), Fr(~OrderCreated2), Fr(~Split2), Fr(~NotifyWarehouse2), Fr(~EBG2), Fr(~message2), Fr(~timer2), Fr(~signal2), Fr(~Continue2), Fr(~OrderCreated3), Fr(~Split3), Fr(~NotifyWarehouse3), Fr(~EBG3), Fr(~message3), Fr(~timer3), Fr(~signal3), Fr(~Continue3), Fr(~OrderCreated4), Fr(~Split4), Fr(~NotifyWarehouse4), Fr(~EBG4), Fr(~message4), Fr(~timer4), Fr(~signal4), Fr(~Continue4), Fr(~OrderCreated5), Fr(~Split5), Fr(~NotifyWarehouse5), Fr(~EBG5), Fr(~message5), Fr(~timer5), Fr(~signal5), Fr(~Continue5), Fr(~OrderCreated6), Fr(~Split6), Fr(~NotifyWarehouse6), Fr(~EBG6), Fr(~message6), Fr(~timer6), Fr(~signal6), Fr(~Continue6), Fr(~OrderCreated7), Fr(~Split7), Fr(~NotifyWarehouse7), Fr(~EBG7), Fr(~message7), Fr(~timer7), Fr(~signal7), Fr(~Continue7), Fr(~OrderCreated8), Fr(~Split8), Fr(~NotifyWarehouse8), Fr(~EBG8), Fr(~message8), Fr(~timer8), Fr(~signal8) ]
  --[ Start(~Start),
      Last(~message8),
      Enter(~Start),
      EdgeDef(~Start, ~OrderCreated1),
      EdgeDef(~OrderCreated1, ~Split1),
      EdgeDef(~message1, ~Continue1),
      EdgeDef(~Continue1, ~OrderCreated2),
      EdgeDef(~OrderCreated2, ~Split2),
      EdgeDef(~message2, ~Continue2),
      EdgeDef(~Continue2, ~OrderCreated3),
      EdgeDef(~OrderCreated3, ~Split3),
      EdgeDef(~message3, ~Continue3),
      EdgeDef(~Continue3, ~OrderCreated4),
      EdgeDef(~OrderCreated4, ~Split4),
      EdgeDef(~message4, ~Continue4),
      EdgeDef(~Continue4, ~OrderCreated5),
      EdgeDef(~OrderCreated5, ~Split5),
      EdgeDef(~message5, ~Continue5),
      EdgeDef(~Continue5, ~OrderCreated6),
      EdgeDef(~OrderCreated6, ~Split6),
      EdgeDef(~message6, ~Continue6),
      EdgeDef(~Continue6, ~OrderCreated7),
      EdgeDef(~OrderCreated7, ~Split7),
      EdgeDef(~message7, ~Continue7),
      EdgeDef(~Continue7, ~OrderCreated8),
      EdgeDef(~OrderCreated8, ~Split8),
      EdgeDef(~Split1, ~NotifyWarehouse1),
      EdgeDef(~Split1, ~EBG1),
      EdgeDef(~Split2, ~NotifyWarehouse2),
      EdgeDef(~Split2, ~EBG2),
      EdgeDef(~Split3, ~NotifyWarehouse3),
      EdgeDef(~Split3, ~EBG3),
      EdgeDef(~Split4, ~NotifyWarehouse4),
      EdgeDef(~Split4, ~EBG4),
      EdgeDef(~Split5, ~NotifyWarehouse5),
      EdgeDef(~Split5, ~EBG5),
      EdgeDef(~Split6, ~NotifyWarehouse6),
      EdgeDef(~Split6, ~EBG6),
      EdgeDef(~Split7, ~NotifyWarehouse7),
      EdgeDef(~Split7, ~EBG7),
      EdgeDef(~Split8, ~NotifyWarehouse8),
      EdgeDef(~Split8, ~EBG8),
      EdgeDef(~EBG1, ~message1),
      EdgeDef(~EBG1, ~timer1),
      EdgeDef(~EBG1, ~signal1),
      EdgeDef(~EBG2, ~message2),
      EdgeDef(~EBG2, ~timer2),
      EdgeDef(~EBG2, ~signal2),
      EdgeDef(~EBG3, ~message3),
      EdgeDef(~EBG3, ~timer3),
      EdgeDef(~EBG3, ~signal3),
      EdgeDef(~EBG4, ~message4),
      EdgeDef(~EBG4, ~timer4),
      EdgeDef(~EBG4, ~signal4),
      EdgeDef(~EBG5, ~message5),
      EdgeDef(~EBG5, ~timer5),
      EdgeDef(~EBG5, ~signal5),
      EdgeDef(~EBG6, ~message6),
      EdgeDef(~EBG6, ~timer6),
      EdgeDef(~EBG6, ~signal6),
      EdgeDef(~EBG7, ~message7),
      EdgeDef(~EBG7, ~timer7),
      EdgeDef(~EBG7, ~signal7),
      EdgeDef(~EBG8, ~message8),
      EdgeDef(~EBG8, ~timer8),
      EdgeDef(~EBG8, ~signal8),
      Gateway(~EBG1),
      Gateway(~EBG2),
      Gateway(~EBG3),
      Gateway(~EBG4),
      Gateway(~EBG5),
      Gateway(~EBG6),
      Gateway(~EBG7),
      Gateway(~EBG8) ]->
    [ Token(~Start),
      !Next(~Start, ~OrderCreated1),
      !Next(~OrderCreated1, ~Split1),
      !Next(~message1, ~Continue1),
      !Next(~Continue1, ~OrderCreated2),
      !Next(~OrderCreated2, ~Split2),
      !Next(~message2, ~Continue2),
      !Next(~Continue2, ~OrderCreated3),
      !Next(~OrderCreated3, ~Split3),
      !Next(~message3, ~Continue3),
      !Next(~Continue3, ~OrderCreated4),
      !Next(~OrderCreated4, ~Split4),
      !Next(~message4, ~Continue4),
      !Next(~Continue4, ~OrderCreated5),
      !Next(~OrderCreated5, ~Split5),
      !Next(~message5, ~Continue5),
      !Next(~Continue5, ~OrderCreated6),
      !Next(~OrderCreated6, ~Split6),
      !Next(~message6, ~Continue6),
      !Next(~Continue6, ~OrderCreated7),
      !Next(~OrderCreated7, ~Split7),
      !Next(~message7, ~Continue7),
      !Next(~Continue7, ~OrderCreated8),
      !Next(~OrderCreated8, ~Split8),
      !Split(~Split1, ~NotifyWarehouse1, ~EBG1),
      !Split(~Split2, ~NotifyWarehouse2, ~EBG2),
      !Split(~Split3, ~NotifyWarehouse3, ~EBG3),
      !Split(~Split4, ~NotifyWarehouse4, ~EBG4),
      !Split(~Split5, ~NotifyWarehouse5, ~EBG5),
      !Split(~Split6, ~NotifyWarehouse6, ~EBG6),
      !Split(~Split7, ~NotifyWarehouse7, ~EBG7),
      !Split(~Split8, ~NotifyWarehouse8, ~EBG8),
      !Alt(~EBG1, ~message1),
      !Alt(~EBG1, ~timer1),
      !Alt(~EBG1, ~signal1),
      !Alt(~EBG2, ~message2),
      !Alt(~EBG2, ~timer2),
      !Alt(~EBG2, ~signal2),
      !Alt(~EBG3, ~message3),
      !Alt(~EBG3, ~timer3),
      !Alt(~EBG3, ~signal3),
      !Alt(~EBG4, ~message4),
      !Alt(~EBG4, ~timer4),
      !Alt(~EBG4, ~signal4),
      !Alt(~EBG5, ~message5),
      !Alt(~EBG5, ~timer5),
      !Alt(~EBG5, ~signal5),
      !Alt(~EBG6, ~message6),
      !Alt(~EBG6, ~timer6),
      !Alt(~EBG6, ~signal6),
      !Alt(~EBG7, ~message7),
      !Alt(~EBG7, ~timer7),
      !Alt(~EBG7, ~signal7),
      !Alt(~EBG8, ~message8),
      !Alt(~EBG8, ~timer8),
      !Alt(~EBG8, ~signal8) ]

// Sequence flow
rule Step_Sequence:
    [ Token(n), !Next(n, m) ]
  --[ Transition(n, m), Enter(m) ]->
    [ Token(m) ]

// Parallel split: one token per outgoing branch
rule Step_Split:
    [ Token(s), !Split(s, b1, b2) ]
  --[ Transition(s, b1), Transition(s, b2), Enter(b1), Enter(b2) ]->
    [ Token(b1), Token(b2) ]

// Event-based gateway: the alternatives compete for the single gateway token
rule Step_EBG:
    [ Token(g), !Alt(g, a) ]
  --[ Transition(g, a), Takes(g, a), Enter(a) ]->
    [ Token(a) ]

// The process is executable: a token reaches the last node of the chain
lemma executable:
  exists-trace
  "Ex n #i #j. Last(n) @ #i & Enter(n) @ #j"

// One token per node: a token enters every node at most once. Induction
// keeps the proof linear in the size of the process.
lemma one_token_per_node [use_induction, reuse]:
  "All n #i #j. Enter(n) @ #i & Enter(n) @ #j ==> #i = #j"

// Only transitions of the BPMN model can take effect
lemma admissible_only:
  "All n m #i. Transition(n, m) @ #i ==> Ex #j. EdgeDef(n, m) @ #j"

// R2 (safety): of the alternatives of every gateway exactly one takes effect
lemma gateway_exclusivity:
  "All g a1 a2 #i #j. Takes(g, a1) @ #i & Takes(g, a2) @ #j ==>
      a1 = a2 & #i = #j"

end
